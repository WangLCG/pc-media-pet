APP_HOST=127.0.0.1
APP_PORT=8000
APP_TOKEN=replace-with-a-unique-secret-of-at-least-16-characters

CAMERA_INDEX=0
# Windows: set to dshow when the default Media Foundation backend drops frames.
CAMERA_BACKEND=auto
CAMERA_IDLE_WIDTH=640
CAMERA_IDLE_HEIGHT=360
CAMERA_IDLE_INTERVAL_SECONDS=2.0
CAMERA_VIEW_WIDTH=1280
CAMERA_VIEW_HEIGHT=720
CAMERA_VIEW_FPS=15
CAMERA_SHUTDOWN_TIMEOUT_SECONDS=5
CAMERA_RETRY_INTERVAL_SECONDS=30
CAMERA_BACKEND=dshow

# DirectShow audio-device alternative name. Leave disabled until a device is verified.
AUDIO_ENABLED=false
AUDIO_DEVICE=
# WebRTC VAD aggressiveness: 0 is permissive, 3 rejects more background noise.
AUDIO_VAD_MODE=3
AUDIO_LOUDNESS_THRESHOLD_DBFS=-35
# Non-speech sounds above this level still trigger, so barks/impacts are not missed.
AUDIO_LOUDNESS_OVERRIDE_DBFS=-22
# 20 ms per frame; 10 frames requires about 200 ms of sustained sound.
AUDIO_CONFIRM_FRAMES=10
AUDIO_COOLDOWN_SECONDS=60
AUDIO_RETRY_INTERVAL_SECONDS=30
AUDIO_SHUTDOWN_TIMEOUT_SECONDS=5

MOTION_MIN_CHANGED_AREA=1800
# Number of consecutive meaningful frame changes required before notifying.
MOTION_CONFIRM_FRAMES=3
MOTION_COOLDOWN_SECONDS=300

NOTIFY_PING_INTERVAL_SECONDS=20
NOTIFY_MISSED_PONG_LIMIT=3
NOTIFY_CHANNEL_OPEN_TIMEOUT_SECONDS=15
NOTIFY_ACK_TIMEOUT_SECONDS=5
NOTIFY_MAX_RETRIES=3
MEDIA_IDLE_TIMEOUT_SECONDS=120
WEBRTC_IPV6_ENABLED=false
